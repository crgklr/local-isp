ANTHROPIC_API_KEY=your-anthropic-api-key
AHREFS_API_KEY=your-ahrefs-api-key
CONTENTFUL_SPACE_ID=your-contentful-space-id
CONTENTFUL_MANAGEMENT_TOKEN=your-contentful-management-token
CONTENTFUL_ENVIRONMENT=master
CONTENTFUL_CONTENT_TYPE_ID=blogPost

# Email - pick SendGrid OR SMTP
SENDGRID_API_KEY=your-sendgrid-api-key
EMAIL_FROM=content-agent@distributorwire.com
EMAIL_TO=your-email@example.com

# IMAP (for polling your replies, also used as SMTP fallback)
IMAP_HOST=imap.gmail.com
IMAP_USER=your-email@gmail.com
IMAP_PASSWORD=your-app-password

# Scheduler
SCOUT_SCHEDULE_HOUR=7
SCOUT_SCHEDULE_MINUTE=0
REPLY_POLL_INTERVAL_MINUTES=5

# Scout thresholds
MAX_KEYWORD_DIFFICULTY=30
MIN_KEYWORD_VOLUME=50
