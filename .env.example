# === REQUIRED: AI Engine ===
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# === REQUIRED: SEO Data ===
AHREFS_API_KEY=your-ahrefs-api-key

# === REQUIRED: Content Publishing ===
# Sign up at contentful.com (free tier works)
# Content type needs: title, slug, body, metaDescription, author
CONTENTFUL_SPACE_ID=your-space-id
CONTENTFUL_MANAGEMENT_TOKEN=CFPAT-your-token
CONTENTFUL_ENVIRONMENT=master
CONTENTFUL_CONTENT_TYPE_ID=blogPost

# === REQUIRED FOR DAILY MODE: Email ===
# Option A: SendGrid (recommended, free = 100 emails/day)
SENDGRID_API_KEY=SG.your-sendgrid-key
# Option B: Gmail SMTP
# IMAP_HOST=imap.gmail.com
# IMAP_USER=you@gmail.com
# IMAP_PASSWORD=xxxx-xxxx-xxxx-xxxx

EMAIL_FROM=marcus@distributorwire.com
EMAIL_TO=your-email@example.com

# === OPTIONAL ===
SCOUT_SCHEDULE_HOUR=7
SCOUT_SCHEDULE_MINUTE=0
REPLY_POLL_INTERVAL_MINUTES=5
MAX_KEYWORD_DIFFICULTY=30
MIN_KEYWORD_VOLUME=50
